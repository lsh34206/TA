PORT=3000
CORS_ORIGIN=http://localhost:5173
# 운영에서는 production 으로 지정하세요. 그러면 아래 JWT_SECRET·SEED_PASSWORD 가 예시 값이거나 짧을 때 서버가 시작하지 않습니다.
# (비워 두면 개발 모드: 같은 경우 경고만 출력)
# NODE_ENV=production
# 로그인 토큰 서명 키 (32자 이상의 임의 문자열). 아래 값은 로컬 개발용 예시이며 운영에서는 반드시 바꾸세요.
JWT_SECRET=change-me-to-a-long-random-string
# 리버스 프록시 뒤에서만 지정 (비워 두면 X-Forwarded-For를 신뢰하지 않음). 개발 서버(Vite 프록시)는 loopback
TRUST_PROXY=loopback
# 연구실 IP (쉼표로 구분). 로컬 테스트는 127.0.0.1. 데이터 파일을 처음 만들 때만 사용
LAB_IPS=127.0.0.1
# 초기 계정 비밀번호 (8자 이상). 데이터 파일을 처음 만들 때만 사용. 아래 값은 로컬 개발용 예시입니다.
SEED_PASSWORD=change-me
# 데이터 폴더 (기본값: backend/data)
# DATA_DIR=
